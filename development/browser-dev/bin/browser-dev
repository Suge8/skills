#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "${1:-}" = "doctor" ]; then
  shift
  exec "$DIR/browser-dev-doctor" "$@"
fi

# `stop` kills only the dedicated instance (matched by its profile path);
# the user's everyday Helium has a different user-data-dir and is never touched.
if [ "${1:-}" = "stop" ]; then
  PROFILE="${BROWSER_DEV_PROFILE:-$HOME/.browser-dev/profile}"
  if ! pkill -f "user-data-dir=$PROFILE" 2>/dev/null; then
    echo "browser-dev: no dedicated instance running"
    exit 0
  fi
  # No event interface for a non-child process exit; bounded poll is the only option.
  for _ in $(seq 1 25); do
    pgrep -f "user-data-dir=$PROFILE" >/dev/null 2>&1 || { echo "browser-dev: stopped"; exit 0; }
    sleep 0.2
  done
  echo "browser-dev: instance still running after 5s" >&2
  exit 1
fi

PORT="${BROWSER_DEV_PORT:-9333}"
MAX_OUTPUT="${BROWSER_DEV_MAX_OUTPUT:-30000}"

if [ "${BROWSER_DEV_SKIP_START:-0}" != "1" ]; then
  if [ "${BROWSER_DEV_VERBOSE_START:-0}" = "1" ]; then
    "$DIR/browser-dev-start"
  else
    start_output="$("$DIR/browser-dev-start" 2>&1)" || {
      printf '%s\n' "$start_output" >&2
      exit 1
    }
  fi
fi

exec agent-browser --cdp "$PORT" --max-output "$MAX_OUTPUT" "$@"
