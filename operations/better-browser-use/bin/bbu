#!/usr/bin/env bash
# bbu = agent-browser + 本机登录态。默认 Chrome for Testing + 按仓库隔离的 session；
# --login 切到 CloakBrowser（反检测）+ 从 Helium 同步的 profile，一个 profile 只能被
# 一个 Chrome 打开，所以 session 固定。启动、复用、回收全由 agent-browser daemon 负责。
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BBU_HOME="${BBU_HOME:-$HOME/.bbu}"

case "${1:-}" in
  sync-profile)
    shift
    exec node "$DIR/sync-profile.js" "$BBU_HOME/profile" "$@"
    ;;
  --login)
    shift
    BIN="${BBU_BIN:-$(ls -d "$HOME"/.cloakbrowser/chromium-*/Chromium.app/Contents/MacOS/Chromium 2>/dev/null | sort -V | tail -n 1)}"
    [ -x "$BIN" ] || { echo "bbu: CloakBrowser not found; run: cloakbrowser install (or set BBU_BIN)" >&2; exit 1; }
    export AGENT_BROWSER_EXECUTABLE_PATH="$BIN"
    export AGENT_BROWSER_PROFILE="$BBU_HOME/profile"
    export AGENT_BROWSER_SESSION=bbu-login
    ;;
  *)
    export AGENT_BROWSER_SESSION="${AGENT_BROWSER_SESSION:-bbu-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}"
    ;;
esac

exec agent-browser "$@"
